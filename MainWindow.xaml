<Window x:Class="AMM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TWM Launcher" Icon="Resources/twm-launcher.ico" Width="1480" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0A0810" Foreground="#F4F3F5"
        FontFamily="Segoe UI" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0A0810"/>
        <SolidColorBrush x:Key="Panel" Color="#14101B"/>
        <SolidColorBrush x:Key="Panel2" Color="#1B1B21"/>
        <SolidColorBrush x:Key="Line" Color="#3D434B"/>
        <SolidColorBrush x:Key="Muted" Color="#8D8D98"/>
        <SolidColorBrush x:Key="Accent" Color="#A7ADB6"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#A7A7B0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3D434B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#A7ADB6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#C5CAD1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F3F5"/>
            <Setter Property="Background" Value="#30343A"/>
            <Setter Property="BorderBrush" Value="#555B64"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3D434B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerCardButton" TargetType="Button">
            <Setter Property="Background" Value="#17121F"/>
            <Setter Property="Foreground" Value="#F4F3F5"/>
            <Setter Property="BorderBrush" Value="#3D434B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3D434B"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#A7ADB6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#55555F"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="NickBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#A7ADB6"/>
            <Setter Property="Background" Value="#17121F"/>
            <Setter Property="BorderBrush" Value="#555B64"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#A7ADB6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <Grid x:Name="Root" Opacity="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0D0A13" BorderBrush="#3D434B" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="15,0,9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="21" Height="21" CornerRadius="6" Background="#A7ADB6" Padding="3">
                        <Image Source="pack://application:,,,/Resources/icon.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="TWM LAUNCHER" FontSize="12" FontWeight="Bold" Foreground="#EDE5F7" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <Border Background="#30343A" CornerRadius="5" Padding="6,3" Margin="9,0,0,0">
                        <TextBlock Text="GAME HUB" FontSize="10" FontWeight="Bold" Foreground="#A7ADB6"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="YOUR WORLD. YOUR RULES." FontSize="10" Foreground="#686071" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="34" Height="26" Content="—" FontSize="14" Foreground="#C9C0D2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeWindow_Click" ToolTip="Свернуть"/>
                    <Button x:Name="MaximizeWindowButton" Width="34" Height="26" Content="□" FontSize="14" Foreground="#C9C0D2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MaximizeWindow_Click" ToolTip="Развернуть"/>
                    <Button Width="34" Height="26" Content="×" FontSize="17" Foreground="#F4F3F5" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseWindow_Click" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="SidebarRail" Grid.Row="1" Grid.Column="0" Background="#100D16" BorderBrush="#25252B" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,34">
                    <Border Width="42" Height="42" Background="#A7ADB6" CornerRadius="13" Padding="6">
                        <Image Source="pack://application:,,,/Resources/icon.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TWM LAUNCHER" FontSize="14" FontWeight="Black"/>
                        <TextBlock Text="GAME HUB / DESKTOP" FontSize="10" Foreground="#777781" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="#696973" Margin="12,0,0,10"/>
                    <Button Style="{StaticResource NavButton}" Background="#30343A" Foreground="#A7ADB6" Click="ScrollToTop_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" FontSize="16" Width="28"/>
                            <TextBlock Text="Главная" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OpenServerBrowser_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◎" FontSize="16" Width="28"/>
                            <TextBlock Text="Игровые серверы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OpenMods_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" FontSize="16" Width="28"/>
                            <TextBlock Text="Мои сборки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="ShowSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌘" FontSize="16" Width="28"/>
                            <TextBlock Text="DLL / ASI моды" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#17121F" BorderBrush="#292930" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="QUICK STATUS" FontSize="11" Foreground="#777781" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse x:Name="QuickStatusDot" Width="7" Height="7" Fill="#A7ADB6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="QuickStatusText" Text="Клиент готов к запуску" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Статус обновляется автоматически." FontSize="12" Foreground="#898993" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource NavButton}" Click="ShowSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="28"/>
                            <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="TWM • YOUR WORLD. YOUR RULES." FontSize="10" Foreground="#5F5F68" Margin="12,14,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="TopBar" Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GAME CENTER   /   01" FontSize="11" FontWeight="Bold" Foreground="#A7ADB6"/>
                    <TextBlock Text="Добро пожаловать обратно" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#17121F" BorderBrush="#2C2C33" BorderThickness="1" CornerRadius="20" Padding="12,9" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#A7ADB6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ЛАУНЧЕР ОНЛАЙН" FontSize="11" FontWeight="Bold" Foreground="#C7C7CE"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Click="ShowSettings_Click">⚙  Параметры</Button>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
                <StackPanel>
                    <Border x:Name="HeroCard" Height="390" CornerRadius="22" Background="#202328" BorderBrush="#3D434B" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="HeroArtwork" Source="pack://application:,,,/Resources/banner.png" Stretch="UniformToFill" Opacity="0.34"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F00B0B0E" Offset="0"/>
                                        <GradientStop Color="#C80B0B0E" Offset="0.47"/>
                                        <GradientStop Color="#000B0B0E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000B0B0E" Offset="0.45"/>
                                        <GradientStop Color="#F00B0B0E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="34,28,34,26">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="TWM ORIGINAL CLIENT" FontSize="11" FontWeight="Bold" Foreground="#A7ADB6"/>
                                    <Border DockPanel.Dock="Right" Background="#17121F" BorderBrush="#3D434B" BorderThickness="1" CornerRadius="18" Padding="11,7">
                                        <TextBlock Text="13 WORLDS AVAILABLE" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="570" HorizontalAlignment="Left">
                                    <Border Background="#A7ADB6" CornerRadius="4" Padding="9,5" HorizontalAlignment="Left">
                                        <TextBlock Text="MULTIPLAYER • AMAZING ONLINE" Foreground="#202328" FontSize="10" FontWeight="Black"/>
                                    </Border>
                                    <TextBlock Text="ТВОЙ МИР.
ТВОЯ ИГРА." FontSize="48" LineHeight="48" FontWeight="Black" LineStackingStrategy="BlockLineHeight" Margin="0,15,0,8"/>
                                    <TextBlock Text="Подключайся к любимому серверу и возвращайся в игру." FontSize="15" Foreground="#C4C1C8" TextWrapping="Wrap" MaxWidth="430"/>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="ТВОЙ НИКНЕЙМ" FontSize="10" FontWeight="Bold" Foreground="#A2A0A8" Margin="0,0,0,8"/>
                                        <TextBox x:Name="NicknameTextBox" Style="{StaticResource NickBox}" MaxLength="24" Text="Player" Width="220" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,12,0">
                                        <TextBlock Text="ВЫБРАННЫЙ МИР" FontSize="10" FontWeight="Bold" Foreground="#A2A0A8" Margin="0,0,0,8"/>
                                        <Border Background="#17121F" BorderBrush="#555B64" BorderThickness="1" CornerRadius="10" Padding="13,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#A7ADB6" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SelectedServerName" Text="RED" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="LaunchGame_Click" VerticalAlignment="Bottom" MinWidth="165" Height="46">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="PlayButtonIcon" Text="▶" FontSize="15" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="PlayButtonLabel" Text="ЗАПУСТИТЬ ИГРУ"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid x:Name="DashboardCards" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#14101B" BorderBrush="#3D434B" BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="CLIENT SESSION" FontSize="11" FontWeight="Bold" Foreground="#85858F"/>
                                    <TextBlock DockPanel.Dock="Right" Text="●" Foreground="#A7ADB6"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Margin="0,18,0,18">
                                    <TextBlock x:Name="SessionStatusText" Text="Готов к запуску" FontSize="21" FontWeight="Bold"/>
                                    <TextBlock Text="Проверь никнейм и выбери игровой мир." FontSize="12" Foreground="#8D8D98" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Center" Click="OpenServerBrowser_Click">ВЫБРАТЬ СЕРВЕР  ↗</Button>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="#14101B" BorderBrush="#3D434B" BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="LOCAL BUILDS" FontSize="11" FontWeight="Bold" Foreground="#85858F"/>
                                <StackPanel Grid.Row="1" Margin="0,18,0,18">
                                    <TextBlock Text="Мои сборки" FontSize="19" FontWeight="Bold"/>
                                    <TextBlock Text="Импорт ZIP / RAR и SA Fixes" FontSize="12" Foreground="#8D8D98" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Click="OpenMods_Click">ОТКРЫТЬ БИБЛИОТЕКУ  ↗</Button>
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" Background="#14101B" BorderBrush="#3D434B" BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="MOD LIBRARY" FontSize="11" FontWeight="Bold" Foreground="#85858F"/>
                                <StackPanel Grid.Row="1" Margin="0,18,0,18">
                                    <TextBlock Text="DLL / ASI" FontSize="23" FontWeight="Black"/>
                                    <TextBlock Text="Управление модификациями" FontSize="12" Foreground="#8D8D98" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Click="ShowSettings_Click">НАСТРОИТЬ МОДЫ  ↗</Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="ServersSectionHeader" Margin="0,30,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MULTIPLAYER / SERVER BROWSER" FontSize="11" FontWeight="Bold" Foreground="#A7ADB6"/>
                            <TextBlock Text="Выбери свой игровой мир" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#17121F" BorderBrush="#3D434B" BorderThickness="1" CornerRadius="9" Padding="12,8" VerticalAlignment="Bottom">
                            <TextBlock Text="13 СЕРВЕРОВ" FontSize="11" FontWeight="Bold" Foreground="#A7ADB6"/>
                        </Border>
                    </Grid>
                    <UniformGrid x:Name="ServersGrid" Columns="3" Margin="0,0,-10,0">
                        <Button Style="{StaticResource ServerCardButton}" Click="Server_Click" Tag="RED" x:Name="ServerRedButton">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#EF4444" CornerRadius="11">
                                    <TextBlock Text="R" FontWeight="Black" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="RED" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="80.66.82.192:7777" FontSize="12" Foreground="#9295AA" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" Foreground="#777B90" FontSize="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ServerCardButton}" Click="Server_Click" Tag="YELLOW" x:Name="ServerYellowButton">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#EAB308" CornerRadius="11">
                                    <TextBlock Text="Y" FontWeight="Black" Foreground="#191607" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
